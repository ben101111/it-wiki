# /opt/it-wiki/.env  –  NICHT ins Git-Repository (steht in .gitignore)
# Rechte: chmod 600 .env

# Öffentlich sichtbare Adressen (so, wie Mitarbeiter sie im Browser aufrufen)
WIKI_URL=http://SERVER-IP:8080
GITEA_URL=http://SERVER-IP:3000
WIKI_PORT=8080

# Lesezugriff ohne Anmeldung (off). Basic-Auth wieder aktivieren: AUTH_BASIC=IT-Wissensdatenbank
AUTH_BASIC=off

# Repository in Gitea (Besitzer/Name) und Branch
GITEA_REPO=it-team/it-wiki
GITEA_BRANCH=main

# OAuth-Anwendung „Decap CMS“ in Gitea (öffentlicher Client mit PKCE, kein Secret nötig)
OAUTH_CLIENT_ID=CLIENT-ID-AUS-GITEA

# Technischer Benutzer mit LESE-Zugriff für den Deploy-Dienst
GITEA_DEPLOY_USER=wiki-deploy
GITEA_DEPLOY_TOKEN=TOKEN-AUS-GITEA

# Build-Ergebnis als grünen/roten Haken in Gitea anzeigen (benötigt Schreibrecht des Deploy-Benutzers)
GITEA_COMMIT_STATUS=false

# Abfrageintervall in Sekunden und Anzahl aufbewahrter Releases
POLL_INTERVAL=30
KEEP_RELEASES=10

# Decap CMS erlaubt die Anmeldung standardmäßig nur über HTTPS. Für http://SERVER-IP:8080/admin/
# schaltet der Deploy-Dienst diese Prüfung frei. Nach Umstellung auf HTTPS: false
DECAP_HTTP_LOGIN=true
