server {
    listen 80;
    server_name _;

    # Live-Version: Symlink auf das zuletzt erfolgreich gebaute Release (vom Deploy-Dienst gesetzt)
    root /srv/site/current;
    index index.html;

    server_tokens off;
    charset utf-8;
    client_max_body_size 1m;

    # Lesezugriff ohne Anmeldung: AUTH_BASIC="off". Mit einem Text (z. B. "IT-Wiki") wird Basic-Auth aktiv.
    auth_basic           "${AUTH_BASIC}";
    auth_basic_user_file /etc/nginx/auth/.htpasswd;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "same-origin" always;
    add_header X-Robots-Tag "noindex, nofollow" always;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml text/plain text/yaml;

    location / {
        try_files $uri $uri/ =404;
    }

    location /assets/ {
        expires 7d;
        add_header Cache-Control "public";
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Robots-Tag "noindex, nofollow" always;
    }

    # Redaktionsoberfläche (Decap CMS). Schreibrechte prüft Gitea bei jeder Änderung.
    location /admin/ {
        types {
            text/html html;
            text/css css;
            application/javascript js;
            text/yaml yml yaml;
            image/svg+xml svg;
        }
        add_header Cache-Control "no-cache" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header Referrer-Policy "same-origin" always;
        add_header X-Robots-Tag "noindex, nofollow" always;
        try_files $uri $uri/ =404;
    }

    # Build-Status und Protokolle des Deploy-Dienstes
    location /admin/build/ {
        alias /srv/site/_status/;
        index index.html;
        types {
            text/html html;
            text/plain log json;
        }
        charset utf-8;
        add_header Cache-Control "no-store" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Robots-Tag "noindex, nofollow" always;
    }
    location = /admin/build/state.json { return 404; }

    location = /healthz {
        auth_basic off;
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location = /robots.txt {
        auth_basic off;
        default_type text/plain;
        return 200 "User-agent: *\nDisallow: /\n";
    }

    error_page 404 /404.html;
}
